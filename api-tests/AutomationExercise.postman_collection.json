        {
          "name": "1. GET All Products List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP transport status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('responseCode in body is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('products is a non-empty array', () => pm.expect(body.products).to.be.an('array').that.is.not.empty);",
                  "pm.test('each product has id, name, price, brand', () => body.products.forEach(p => pm.expect(p).to.include.keys('id', 'name', 'price', 'brand')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productsList",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
